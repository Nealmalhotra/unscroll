# Copy to .env and adjust. `npm start` loads .env automatically if it exists.

# Port and interface to listen on.
PORT=8787
HOST=0.0.0.0

# Where the JSON database is stored. Put it on a persistent volume in production.
DATA_FILE=./data/db.json

# Secret for POST /v1/admin/rollover (weekly league promotions). Leave empty to disable.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=60

# Set to 1 behind a proxy (fly.io, nginx) so rate limiting sees the real client IP.
TRUST_PROXY=0
